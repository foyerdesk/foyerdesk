{
  "name": "lavatti-web-support",
  "account_id": "855f449325dc08c24009c99b524c8ff6",
  "main": "../../packages/worker/src/worker.mjs",
  "compatibility_date": "2026-11-23",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "lavatti.com/api/auth/*", "zone_name": "lavatti.com" },
    { "pattern": "lavatti.com/api/support/*", "zone_name": "lavatti.com" }
  ],
  "vars": {
    "LOGTO_ISSUER": "https://auth.lavatti.com/oidc",
    "LOGTO_CLIENT_ID": "ogs96gy37ubbzyckcd2w1",
    "CALLBACK_URI": "https://lavatti.com/api/auth/callback",
    "CHATWOOT_BASE_URL": "https://support.lavatti.com",
    "CHATWOOT_ACCOUNT_ID": "1",
    "IDENTIFIER_PREFIX": "lavatti-logto-",
    "DEFAULT_CONTACT_NAME": "Lavatti participant",
    "REQUEST_MARKER": "lavatti_request_id",
    "RETURN_PATHS": "/support,/talk",
    "FULL_PAGE_INBOX_ID": "5"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SUPPORT_SESSIONS", "class_name": "TestSupportSession" },
      { "name": "FULL_PAGE_THREAD", "class_name": "TestSupportThread" },
      { "name": "SUPPORT_STREAM", "class_name": "SupportStream" },
      { "name": "EMAIL_LINKS", "class_name": "EmailLinkStore" }
    ]
  },
  "migrations": [
    { "tag": "session-v1", "new_sqlite_classes": ["TestSupportSession"] },
    { "tag": "thread-v1", "new_sqlite_classes": ["TestSupportThread"] },
    { "tag": "stream-v1", "new_sqlite_classes": ["SupportStream"] },
    { "tag": "emaillink-v1", "new_sqlite_classes": ["EmailLinkStore"] }
  ]
}
